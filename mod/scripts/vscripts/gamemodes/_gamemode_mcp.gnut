untyped
global function GamemodeMCP_Init

global hardpointsReady = 0

struct NewHardpointState
{
	entity trigger
	vector origin
	vector angles
}

void function GamemodeMCP_Init()
{
	Riff_ForceTitanAvailability( eTitanAvailability.Never )

	Hardpoints_Init()

	SetSpawnpointGamemodeOverride( CAPTURE_POINT )
	ScoreEvent_SetupEarnMeterValuesForMixedModes()
	SetPlayThreeMinuteMusic( true )
	SetPlayThreeMinuteMusicCheck( ThreeMinuteMusicCheck )

	AddCallback_EntitiesDidLoad( EntitiesDidLoad_SpawnHardpoints )
	AddCallback_OnPlayerKilled( Hardpoints_OnPlayerKilled_UpdateMedals )

	ScoreEvent_SetEarnMeterValues( "KillPilot", 0.1, 0.12 )
	ScoreEvent_SetEarnMeterValues( "KillTitan", 0, 0 )
	ScoreEvent_SetEarnMeterValues( "TitanKillTitan", 0, 0 )
	ScoreEvent_SetEarnMeterValues( "PilotBatteryStolen", 0, 35 )
	ScoreEvent_SetEarnMeterValues( "Headshot", 0, 0.02 )
	ScoreEvent_SetEarnMeterValues( "FirstStrike", 0, 0.05 )

	ScoreEvent_SetEarnMeterValues( "ControlPointCapture", 0.1, 0.1 )
	ScoreEvent_SetEarnMeterValues( "ControlPointHold", 0.02, 0.02 )
	ScoreEvent_SetEarnMeterValues( "ControlPointAmped", 0.2, 0.15 )
	ScoreEvent_SetEarnMeterValues( "ControlPointAmpedHold", 0.05, 0.05 )

	ScoreEvent_SetEarnMeterValues( "HardpointAssault", 0.1, 0.15 )
	ScoreEvent_SetEarnMeterValues( "HardpointDefense", 0.5, 0.1 )
	ScoreEvent_SetEarnMeterValues( "HardpointPerimeterDefense", 0.1, 0.12 )
	ScoreEvent_SetEarnMeterValues( "HardpointSiege", 0.1, 0.15 )
	ScoreEvent_SetEarnMeterValues( "HardpointSnipe", 0.1, 0.15 )

	RegisterSignal( "StoppedHardpointMovement" )
}

void function EntitiesDidLoad_SpawnHardpoints()
{
	#if BP_ORT && BOTEXTRAS
		if ( GetConVarBool( "auto_select_gamemode" ) )
			SetConVarInt( "bot_cmds_type", 8 )
	#endif

	foreach ( entity hp in GetEntArrayByClass_Expensive( "info_hardpoint" ) )
	{
		if ( GameModeRemove( hp ) )
			continue

		HardpointState hpState
		hpState.group = CapturePoint_GetGroup( hp )
		hpState.ent = hp
		hpState.prop = CreatePropDynamic( hp.GetModelName(), hp.GetOrigin(), hp.GetAngles(), SOLID_VPHYSICS )
		hpState.trigger = GetEnt( expect string( hp.kv.triggerTarget ) )
		CPstate.hardpoints.append( hpState )

		switch ( hpState.group )
		{
			case "A":
				hp.SetHardpointID( 0 )
				break

			case "B":
				hp.SetHardpointID( 1 )
				break

			case "C":
				hp.SetHardpointID( 2 )
				break

			default:
				throw "unknown hardpoint group name"
		}

		SetTeam( hpState.ent, TEAM_UNASSIGNED )
		SetGlobalNetEnt( "objective" + hpState.group + "Ent", hpState.ent )

		hpState.trigger.SetEnterCallback( OnHardpointEnter )
		hpState.trigger.SetLeaveCallback( OnHardpointLeave )
		hpState.trigger.SetOwner( hp )

		hpState.ent.SetHardpointEstimatedCaptureTime( -1 )
		hpState.ent.SetHardpointProgressRefPoint( 0 )
		hpState.ent.Minimap_SetCustomState( hpState.ent.GetHardpointID() + 1 )
		hpState.ent.Minimap_AlwaysShow( TEAM_MILITIA, null )
		hpState.ent.Minimap_AlwaysShow( TEAM_IMC, null )
		hpState.ent.Minimap_SetAlignUpright( true )

		hpState.ent.s.prop <- hpState.prop
		hpState.ent.s.state <- CAPTURE_POINT_STATE_UNASSIGNED
		hpState.ent.s.lastCappedBy <- TEAM_UNASSIGNED
		hpState.ent.s.wasJustCapping <- false
		hpState.ent.s.lastPower <- 0

		hpState.ent.s.offsetRef <- CreateScriptRef( hpState.ent.GetOrigin() + < 0, 0, 64 >, < 0.0, 0.0, 0.0 > )
		hpState.ent.s.offsetRef.SetParent( hpState.prop )
		// hpState.ent.s.offsetRef.SetLocalOrigin( < 0, 0, 64 > )

		HARDPOINTS.append( hpState.ent ) // for vo script
		hpState.ent.s.trigger <- hpState.trigger // also for vo script

		thread PlayAnim( hpState.prop, "mh_inactive_idle" )

		thread Hardpoint_Think( hpState )
	}

	thread TrackChevronStates()
	#if BP_ORT && OCTBOTS
		thread HandleCapturepointMovement()
	#else
		throw "no bp_ort; install bp_ort"
	#endif
}

void function HandleCapturepointMovement()
{
	while ( GetGameState() != eGameState.Playing )
		svGlobal.levelEnt.WaitSignal( "GameStateChanged" )

	float waitTime = 30
	float lastStart = Time()
	while ( GetGameState() <= eGameState.Playing )
	{
		wait waitTime

		if ( GetGameState() > eGameState.Playing )
			break

		CPstate.hardpoints.randomize()
		vector destination = CPstate.hardpoints[ CPstate.hardpoints.len() - 1 ].prop.GetOrigin()
		vector angles = CPstate.hardpoints[ CPstate.hardpoints.len() - 1 ].prop.GetAngles()
		entity trigger = CPstate.hardpoints[ CPstate.hardpoints.len() - 1 ].trigger
		foreach ( HardpointState hardpoint in CPstate.hardpoints )
		{
			hardpoint.trigger.Disable()

			NewHardpointState newHp
			newHp.trigger = trigger
			newHp.origin = destination
			newHp.angles = angles

			WaitFrame()
			thread HandleSingleHardpointMovement( hardpoint, newHp )
			WaitFrame()
			thread HandleHardpointRuiMovement( hardpoint )
			WaitFrame()
			thread HandleHardpointTrigger( hardpoint, CreateTriggerRadiusMultiple( hardpoint.prop.GetOrigin(), 400.0, [], TRIG_FLAG_PLAYERONLY, 400.0, -400.0 ) )
			destination = hardpoint.prop.GetOrigin()
			angles = hardpoint.prop.GetAngles()
			trigger = hardpoint.trigger
		}

		lastStart = Time()
		while ( hardpointsReady < 3 )
			WaitFrame()

		foreach ( entity player in GetPlayerArray() )
			Remote_CallFunction_Replay( player, "ServerCallback_MobileCapturepoints_Moving" )

		while ( hardpointsReady > 0 )
			WaitFrame()

		foreach ( entity player in GetPlayerArray() )
			Remote_CallFunction_Replay( player, "ServerCallback_MobileCapturepoints_Settled" )

		waitTime = min( max( fabs( Time() - lastStart - 20 ), 5 ), 20 ) + 10
	}
}

void function HandleSingleHardpointMovement( HardpointState hp, NewHardpointState newHp )
{
	if ( !IsNewThread() )
	{
		thread HandleSingleHardpointMovement( hp, newHp )
		return
	}

	WaitFrame()

	vector start = hp.prop.GetOrigin() + < 0, 0, 150 >
	vector end = newHp.origin + < 0, 0, 150 >
	vector midpoint = ( start + end ) / 2.0

	int numPositions = 10
	array<vector> randomSpots = NavMesh_RandomPositions( midpoint, HULL_TITAN, numPositions, 0, sqrt( DistanceSqr( midpoint, start ) ) )

	array<vector> path = []
	if ( randomSpots.len() != 0 )
	{
		path = []
		randomSpots.randomize()

		midpoint = randomSpots[ RandomInt( randomSpots.len() - 1 ) ] + < 0, 0, 150 >

		// try {
		foreach ( vector point in FindPath( start, midpoint ) )
			path.append( point )
		// } catch (err1) { printt( "error in FindPath : ", err1) }
		// try {
		foreach ( vector point in FindPath( midpoint, end ) )
			path.append( point )
		// } catch (err2) { printt( "error in FindPath : ", err2) }
	}
	else
	{
		path = FindPath( start, end )
	}

	thread HandleSingleHardpointMovementFollow( hp, newHp, path )
}

void function HandleSingleHardpointMovementFollow( HardpointState hp, NewHardpointState newHp, array<vector> path )
{
	if ( !IsNewThread() )
	{
		thread HandleSingleHardpointMovementFollow( hp, newHp, path )
		return
	}

	hardpointsReady += 1

	while ( hardpointsReady < 3 )
		WaitFrame()

	thread EmitHardpointHoverSound( hp )

	array<entity> activeFX
	entity dirFX

	try
	{
		activeFX.append(
			StartParticleEffectOnEntityWithPos_ReturnEntity(
				hp.prop,
				GetParticleSystemIndex( $"P_team_jet_hover_HLD" ),
				FX_PATTACH_CUSTOMORIGIN_FOLLOW,
				hp.prop.LookupAttachment( "REF" ),
				< -10, -10, -2 >,
				< 90, 90, 90 >
			)
		)
		activeFX.append(
			StartParticleEffectOnEntityWithPos_ReturnEntity(
				hp.prop,
				GetParticleSystemIndex( $"P_team_jet_hover_HLD" ),
				FX_PATTACH_CUSTOMORIGIN_FOLLOW,
				hp.prop.LookupAttachment( "REF" ),
				< 10, 10, -2 >,
				< 90, 90, 90 >
			)
		)
		activeFX.append(
			StartParticleEffectOnEntityWithPos_ReturnEntity(
				hp.prop,
				GetParticleSystemIndex( $"P_team_jet_hover_HLD" ),
				FX_PATTACH_CUSTOMORIGIN_FOLLOW,
				hp.prop.LookupAttachment( "REF" ),
				< 10, -10, -2 >,
				< 90, 90, 90 >
			)
		)
		activeFX.append(
			StartParticleEffectOnEntityWithPos_ReturnEntity(
				hp.prop,
				GetParticleSystemIndex( $"P_team_jet_hover_HLD" ),
				FX_PATTACH_CUSTOMORIGIN_FOLLOW,
				hp.prop.LookupAttachment( "REF" ),
				< -10, 10, -2 >,
				< 90, 90, 90 >
			)
		)
	}
	catch ( err )
	{
	}

	// angle it correctly
	hp.prop.SetAngles( < 0, hp.prop.GetAngles().y, 0 > )

	entity mover = CreateScriptMover( hp.prop.GetOrigin(), hp.prop.GetAngles() )
	hp.prop.SetParent( mover )

	float speed = 50.0
	float totalTime = Distance2D( hp.prop.GetOrigin(), newHp.origin ) / speed
	float timePerLine = min( max( totalTime / path.len(), 0.01 ), 5.0 )

	foreach ( vector point in path )
	{
		try
		{
			float angle = RadToDeg( DotProduct( hp.prop.GetOrigin(), point ) )
			dirFX =
				StartParticleEffectOnEntityWithPos_ReturnEntity(
					hp.prop,
					GetParticleSystemIndex( $"P_team_jet_hover_HLD" ),
					FX_PATTACH_CUSTOMORIGIN_FOLLOW,
					hp.prop.LookupAttachment( "REF" ),
					< 0, 0, 20 >,
					< 0, angle, 0 >
				)
		}
		catch ( err )
		{
		}

		point = FitHardpoint( hp.prop, point )
		mover.NonPhysicsMoveTo( point, timePerLine, 0.0, 0.0 )

		WaitFrame()

		if ( IsValid( dirFX ) )
			dirFX.Destroy()
	}

	mover.NonPhysicsMoveTo( newHp.origin, timePerLine * 2, 0.0, 0.0 )
	mover.NonPhysicsRotateTo( newHp.angles, timePerLine * 4, 0.0, 0.0 )

	wait timePerLine * 4 // wait last moveto

	// clear mover
	hp.prop.ClearParent()
	mover.Destroy()

	// setup new hp
	hp.prop.SetOrigin( newHp.origin )
	hp.prop.SetAngles( newHp.angles )
	hp.ent.SetOrigin( hp.prop.GetOrigin() )

	// setup new trigger
	hp.trigger = newHp.trigger
	hp.trigger.SetOwner( hp.ent )
	hp.trigger.Enable()

	hp.ent.Signal( "StoppedHardpointMovement" )

	hardpointsReady -= 1

	hp.trigger.SearchForNewTouchingEntity()

	if ( IsValid( dirFX ) )
		dirFX.Destroy()
	foreach ( fx in activeFX )
	{
		if ( IsValid( fx ) )
			fx.Destroy()
	}
}

vector function FitHardpoint( entity prop, vector point )
{
	return point + FitHardpointAxial( prop, point, < 1, 0, 0 > ) + FitHardpointAxial( prop, point, < 0, 1, 0 > ) + FitHardpointAxial( prop, point, < 0, 0, 1 > )
}

const float FloatingDist = 20.0
vector function FitHardpointAxial( entity prop, vector point, vector dir )
{
	float l = -FitHardpointDir( prop, point, dir )
	float r = FitHardpointDir( prop, point, -dir )

	if ( fabs( l ) != FloatingDist && fabs( r ) != FloatingDist )
		return ( ( l + r ) / 2.0 ) * dir
	if ( -l < r )
		return -( l + FloatingDist ) * dir
	if ( -l > r )
		return -( l - FloatingDist ) * dir
	return < 0, 0, 0 >
}

float function FitHardpointDir( entity prop, vector point, vector dir )
{
	TraceResults trace = TraceLine( point, point + dir * FloatingDist, [ prop ], TRACE_MASK_SHOT, TRACE_COLLISION_GROUP_DEBRIS )
	return sqrt( DistanceSqr( trace.endPos, point ) )
}

void function HandleHardpointRuiMovement( HardpointState hp )
{
	hp.ent.EndSignal( "StoppedHardpointMovement" )

	foreach ( entity player in GetPlayerArray() )
		Remote_CallFunction_NonReplay( player, "ServerCallback_MobileCapturepointMoveUI", hp.ent.GetEncodedEHandle(), hp.ent.s.offsetRef.GetEncodedEHandle() )

	OnThreadEnd(
		function() : ( hp )
		{
			foreach ( entity player in GetPlayerArray() )
				Remote_CallFunction_NonReplay( player, "ServerCallback_MobileCapturepointStopUIMove", hp.ent.GetEncodedEHandle() )
		}
	)

	for ( ; ; )
	{
		hp.ent.SetOrigin( hp.prop.GetOrigin() )
		WaitFrame()
	}
}

void function HandleHardpointTrigger( HardpointState hp, entity trigger )
{
	hp.ent.EndSignal( "StoppedHardpointMovement" )
	trigger.SetParent( hp.prop )
	trigger.SetOwner( hp.ent )

	AddCallback_ScriptTriggerEnter( trigger, OnHardpointEnter )
	AddCallback_ScriptTriggerLeave( trigger, OnHardpointLeave )

	OnThreadEnd(
		function() : ( hp, trigger )
		{
			foreach ( entity ent in GetAllEntitiesInTrigger( trigger ) )
				OnHardpointLeave( trigger, ent )
			trigger.Destroy()

			hp.trigger.SearchForNewTouchingEntity()
			foreach ( entity ent in hp.trigger.GetTouchingEntities() )
				OnHardpointEnter( hp.trigger, ent )
		}
	)

	hp.ent.WaitSignal( "StoppedHardpointMovement" )
}

void function EmitHardpointHoverSound( HardpointState hp )
{
	if ( !IsNewThread() )
	{
		thread EmitHardpointHoverSound( hp )
		return
	}

	hp.ent.EndSignal( "StoppedHardpointMovement" )

	OnThreadEnd(
		function() : ( hp )
		{
			StopSoundOnEntity( hp.prop, "titan_core_flight_hover_3p" )
		}
	)

	for ( ; ; )
	{
		EmitSoundOnEntity( hp.prop, "titan_core_flight_hover_3p" ) // boost_hover_body_3p_enemy
		wait 3.5 // GetSoundDuration( "titan_core_flight_hover_3p_enemy" ) // 3.94069
	}
}

array<vector> function FindPath( vector start, vector end )
{
	array<vector> path = []

	#if OCTBOTS
		array<array<vector> > out_path
		// doing this is does really weird stuff
		OcttreeFindPath( start, end, out_path )
		path = out_path[ 0 ]
	#endif

	return path
}

bool function ThreeMinuteMusicCheck( int timeLeftSeconds, float timeLimit )
{
	return level.nv.matchProgress >= 70 || timeLeftSeconds < ( timeLimit * 0.4 - 60 )
}
